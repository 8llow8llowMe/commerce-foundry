# 프론트엔드 환경변수 — 키 이름만 둔다. 실값은 앱 디렉터리의 .env.local 또는 배포 환경에 넣는다.
# 사업자 정보 실값은 Vault 에 있다 (backend/docs/secret-management.md).

# 서버 전용 — BFF · Server Component 가 부를 게이트웨이 주소 (기본값 http://localhost:8000)
GATEWAY_URL=

# 서버 전용 — BFF 가 클라이언트 IP 를 읽을 요청 헤더. 앞단(호스팅 플랫폼 · LB)이 브라우저 값을 버리고 덮어쓰는 헤더여야 한다.
# 기본 x-real-ip, XFF 를 덧붙이는 L7 LB 한 단 뒤면 x-forwarded-for(맨 오른쪽), 앞단이 없으면 none (docs/architecture.md §2)
CLIENT_IP_HEADER=

# 공개 — 기본 호스트의 정식 주소(예: https://example.com). hreflang · canonical 의 절대 URL (기본값 http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# 공개(storefront) — 토스페이먼츠 결제위젯 클라이언트 키(test_gck_ / live_gck_ 만, 공개돼도 되는 키). 빌드 시점에 번들로 들어간다.
# 비우거나 결제위젯 키가 아니면 결제 화면이 "지금은 결제를 받을 수 없음" 을 보인다. 시크릿 키(gsk/sk)는 넣지 않는다 — BE Vault 의 TOSS_SECRET_KEY 다
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# 서버 전용 — 언어 전용 호스트(예: en=en.example.com). 비우면 영문은 경로 방식(/en/...). 빌드 · 실행에 같은 값
LOCALE_HOSTS=

# 서버 전용(storefront) — 메인 전시 미리보기(#71)를 iframe 으로 여는 어드민 origin(예: https://admin.example.com).
# /preview/* 의 frame-ancestors · postMessage 발신자 확인에 쓴다. 비우면 개발 http://localhost:3001, 운영은 미리보기를 닫는다. 빌드 · 실행에 같은 값
ADMIN_ORIGIN=

# 서버 전용(admin) — 미리보기가 iframe 으로 여는 스토어프론트 origin(예: https://example.com). 비우면 개발 http://localhost:3000, 운영은 미리보기를 끈다
STOREFRONT_ORIGIN=

# 푸터 사업자 · 고객센터 정보와 쇼핑몰 표시 이름은 env 가 아니라 어드민 '쇼핑몰 설정 > 쇼핑몰 정보'(#568)가 정본이다.
# 스토어프론트는 요청마다 GET /api/v1/store/profile 로 읽는다 — 예전 BUSINESS_* 키는 쓰지 않는다
