{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["GATEWAY_URL", "NEXT_PUBLIC_SITE_URL", "LOCALE_HOSTS", "BUSINESS_*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["GATEWAY_URL", "NEXT_PUBLIC_SITE_URL"]
    }
  }
}
