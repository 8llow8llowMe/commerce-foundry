{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "GATEWAY_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_TOSS_CLIENT_KEY",
        "LOCALE_HOSTS",
        "ADMIN_ORIGIN"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "GATEWAY_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_TOSS_CLIENT_KEY",
        "ADMIN_ORIGIN",
        "STOREFRONT_ORIGIN"
      ]
    }
  }
}
