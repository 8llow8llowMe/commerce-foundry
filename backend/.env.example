# commerce-foundry 백엔드가 읽는 키 목록이다. 값은 비워 둔 채로 커밋한다.
#
# - 실제 값은 Vault 에 등록한다. Vault 키 이름 = 이 파일의 변수 이름이다.
# - 로컬에서는 이 파일을 backend/.env 로 복사해 테스트 값만 채운다. .env 는 .gitignore 로 막혀 있다.
# - 키를 추가·변경하면 이 파일, 쓰는 서비스의 application*.yml, Vault 를 같은 PR 에서 맞춘다.
# - 규칙 정본: backend/docs/secret-management.md / Vault 주입 방식: #32
#
# 값 뒤에 주석을 붙이지 않는다. properties 로 읽히면 주석까지 값이 된다.

# ── 실행 프로파일 ─────────────────────────────────────────
# 비워 둔다. 로컬 bootRun 은 값이 없거나 비어 있으면 local 로 뜬다(backend/build.gradle).
# 배포 환경은 반드시 명시한다 — 이 파일을 배포 템플릿으로 복사해도 local(ddl-auto update · Swagger 열림)로 뜨지 않게 하려는 것이다.
SPRING_PROFILES_ACTIVE=

# ── 서비스 디스커버리 · 게이트웨이 ─────────────────────────────
# 비밀이 아닌 로컬 기본값이라 채워 둔다.
# Eureka 클라이언트(api-gateway · 서비스 전부)가 등록할 Eureka 서버 호스트. 포트(8761) · 경로는 application.yml 이 붙인다. yml 기본값과 같다.
# 배포 환경은 Eureka 컨테이너 이름(commerce-service-discovery-<env>)이다 (deploy-guide.md §4).
EUREKA_HOST=localhost
# Eureka 레지스트리 HTTP Basic 비밀번호 (#248) — 시크릿. service-discovery · api-gateway · 서비스 전부 같은 값, 환경마다 다른 값.
# openssl rand -hex 32 로 만든다. 영문 · 숫자 · . _ ~ - 만, 32자 이상 — 클라이언트 URL 에 실리는 값이라 다른 문자는 쓸 수 없고 Eureka 가 기동하지 않는다.
# 기본값이 없다 — 로컬도 채워야 Eureka · 게이트웨이 · 서비스가 뜬다 (security-guide.md §12)
EUREKA_PASSWORD=
# api-gateway 가 CORS 를 허용할 프론트 origin. 여러 개면 콤마로 구분한다. 비우면 어떤 origin 도 허용하지 않는다.
# 공통 application.yml 의 기본값은 비어 있어(닫힘) 배포 환경은 반드시 채운다. local 프로파일 기본값은 이 값과 같다.
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000
# api-gateway 가 토큰 없는 요청을 클라이언트 IP 단위로 세고, 하류에 X-Client-Subject(IP 의 HMAC)를 실을지(true / false). 넣지 않으면 false 다.
# 아래 GATEWAY_TRUSTED_PROXIES · GATEWAY_CLIENT_IP_HASH_KEY 를 채운 뒤 dev 부터 켠다. 불리언이 아니거나 빈 값(`=`)이면 게이트웨이가 뜨지 않는다 (backend/docs/security-guide.md §7-3).
GATEWAY_CLIENT_IP_ENABLED=false
# api-gateway 가 X-Forwarded-For 를 믿을 프록시의 주소 · CIDR — 우리가 운영하는 BFF · L7 LB 중 XFF 를 덧붙이거나 한 값으로 덮어쓰는 것만, 공용 CDN 대역 금지. 여러 개면 콤마로 구분한다. 비우면 어떤 프록시도 믿지 않는다(소켓 원격 주소 사용).
# BFF · LB 뒤에서 비워 두면 비로그인 요청 전체가 버킷 하나다 — 그래서 비로그인 IP 계수(gateway.client-ip.enabled)는 기본 끔이다. 구성이 정해지기 전까지 비워 둔다 (backend/docs/security-guide.md §7-3).
GATEWAY_TRUSTED_PROXIES=
# api-gateway 가 클라이언트 IP 를 Redis 키 · 하류 X-Client-Subject 값으로 바꾸는 HMAC 키(비밀, Vault, 게이트웨이 전용). base64 로 인코딩한 32바이트 이상 난수, 게이트웨이 인스턴스 전부 같은 값.
# gateway.client-ip.enabled 를 켤 때만 필수다. 끈 기본값에서는 비워도 게이트웨이가 뜬다. 만들기: openssl rand -base64 32
GATEWAY_CLIENT_IP_HASH_KEY=

# ── PostgreSQL (서비스 전부 · 스키마는 서비스별) ──────────────
DB_URL=jdbc:postgresql://localhost:5432/commerce_foundry
DB_USERNAME=
DB_PASSWORD=

# ── Snowflake ID (서비스 전부 · dev/prod) ─────────────────────
# 비밀은 아니지만 인스턴스마다 (datacenter, worker) 쌍이 달라야 한다. 각 0~31.
# datacenter 는 배포 환경(dev · prod)이 넣고, worker 는 배포 compose 가 서비스마다 고정한다.
# local 은 application-local.yml 이 서비스마다 고정값을 쓰므로 둘 다 비워 둔다.
SNOWFLAKE_DATACENTER_ID=
# 배포 compose 는 서비스마다 고정한다(deploy-guide.md §4-1) — 배포 환경 secret 에 등록하지 않는다
SNOWFLAKE_WORKER_ID=

# ── Redis (auth · order · api-gateway) ───────────────────────
# api-gateway 는 로그아웃 차단 목록을 읽는다(#4). auth 와 같은 Redis 를 가리켜야 한다 — 다르면 로그아웃한 토큰이 그대로 통과한다.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka (비동기 메시징 — #304 · #310) ─────────────────────────
# 로컬은 docker-compose-local.yml 의 단일 노드 Kafka 다. dev 는 Infra 공유 클러스터 주소를 Vault 에서 받는다 — 주소를 저장소에 쓰지 않는다.
# operations-service 가 읽는다(#307 — 백그라운드 작업 실행 신호). 꺼져 있으면 작업이 등록만 되고 실행되지 않는다 — 작업을 돌리려면 켜고 로컬 Kafka 를 띄운다.
# product-service 도 읽는다(#309 — 주문 만료 · 취소 이벤트 → 재고 선점 해제 컨슈머, compose 가 넘긴다). 꺼져 있으면 만료 스윕 · internal 해제가 지금처럼 푼다.
# 다른 서비스는 컨슈머(#308)가 읽기 시작하는 PR 에서 그 모듈 yml · compose 에 더한다(deploy-guide.md §8).
# 이름 · 비밀 여부는 #304 설계 A-7 이다. MESSAGING_ENABLED 를 켜면 아래 키가 필수다(#306).
MESSAGING_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# 토픽 · 컨슈머 그룹 이름 앞에 붙는다 — commerce-foundry.<env>. 마지막 토막이 실행 프로파일과 같아야 한다(local · dev, 프로파일 없음 = prod)
KAFKA_NAMESPACE=commerce-foundry.local
# 지금은 PLAINTEXT · SASL 없음(공유 클러스터 ACL 은 Infra 후속, #304 Q6). SASL 키는 둘 다 비우거나 둘 다 채운다 — 하나만 채우면 기동하지 않는다
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# 로컬 compose 의 Kafka 호스트 포트. 다른 프로젝트와 겹치면 바꾸고 위 주소의 포트도 같이 바꾼다
KAFKA_PORT=9092

# ── JWT (auth 발급 · api-gateway·서비스 검증) ─────────────────
# RS256 키 쌍이다. 값은 PEM 본문 한 줄(아머 없이)로 넣는다. 만들기·한 줄 변환·교체 순서: backend/docs/security-guide.md §6
# 서명 개인키 — PKCS#8(BEGIN PRIVATE KEY), RSA 2048비트 이상. auth-service 에만 둔다.
JWT_PRIVATE_KEY=
# 검증 공개키 — X.509(BEGIN PUBLIC KEY). auth · api-gateway · 서비스 전부가 읽는다.
JWT_PUBLIC_KEY=
# 키 교체 중에만 이전 공개키를 넣는다. 평소에는 비워 둔다.
JWT_PUBLIC_KEY_PREVIOUS=

# ── 서비스 간 인증 (서비스 전부 · api-gateway 제외) ─────────────────
# internal API 서비스 토큰의 공용 HS256 비밀이다. base64 로 인코딩한 32바이트 이상 난수를 넣고, 서비스 전부가 같은 값을 쓴다.
# 만들기: openssl rand -base64 32 / 교체 순서: backend/docs/security-guide.md §9-7
INTERNAL_JWT_SECRET=
# 비밀 교체 중에만 채운다(교체 ①은 새 비밀, ②는 옛 비밀). 평소에는 비워 둔다.
INTERNAL_JWT_SECRET_PREVIOUS=

# ── 로그인 · 회원가입 시도 제한 (auth) ─────────────────────────
# auth-service 가 로그인 · 회원가입 시도 카운터 키(정규화 이메일)를 Redis 키로 바꾸는 HMAC 키(비밀, Vault). base64 로 인코딩한 32바이트 이상 난수, auth 인스턴스 전부 같은 값.
# 시도 제한(auth.login-guard.enabled)이 기본 켬이라 필수다 — 비면 auth 가 뜨지 않는다. 바꾸면 진행 중인 시도 창이 초기화된다 (security-guide.md §14-4).
# 만들기: openssl rand -base64 32
AUTH_LOGIN_GUARD_HASH_KEY=
# 시도 제한 끄기(비상용) — 비밀이 아니라 설정 스위치라 Vault 에 등록하지 않는다. 넣지 않으면 켬(true)이다.
# 빈 값 줄(AUTH_LOGIN_GUARD_ENABLED=)을 두지 않는다 — 빈 문자열은 기본값 true 로 가지 않고 바인딩에 실패해 auth 가 뜨지 않는다. 끌 때만 주석을 풀어 넣는다 (security-guide.md §12-4)
# AUTH_LOGIN_GUARD_ENABLED=false

# ── 관리자 OTP (auth) ─────────────────────────────────────────
# auth-service 가 관리자 TOTP 비밀을 DB 에 AES-256-GCM 으로 저장하는 키(비밀, Vault). base64 로 인코딩한 정확히 32바이트 난수, auth 인스턴스 전부 같은 값.
# 항상 필수다 — 비면 auth 가 뜨지 않는다. 잃으면 등록된 OTP 를 모두 읽지 못한다. 회전 절차: backend/docs/secret-management.md (관리자 OTP 키)
# 만들기: openssl rand -base64 32
AUTH_OTP_SECRET_KEY=
# 키 회전 중에만 채운다(이전 키, 복호화 전용). 평소에는 비워 둔다. 현재 키와 같은 값이면 auth 가 뜨지 않는다.
AUTH_OTP_SECRET_KEY_PREVIOUS=
# 인증 앱에 보이는 발급자 이름 — 비밀이 아닌 설정이라 Vault 에 등록하지 않는다. 넣지 않으면 "Commerce Foundry Admin". ':' 는 넣을 수 없다.
# AUTH_OTP_ISSUER=

# ── 소셜 로그인 (auth) ───────────────────────────────────────
# 기본은 전부 꺼짐. 전체 및 사용할 제공자를 함께 켠다. 활성 제공자는 ID · secret · 고정 redirect URI가 모두 필수다.
# Kakao 콘솔에서 Client Secret 사용을 활성화한다. 제공자 콘솔의 콜백 URI와 정확히 같아야 한다.
AUTH_SOCIAL_ENABLED=false
KAKAO_LOGIN_ENABLED=false
KAKAO_REDIRECT_URI=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_LOGIN_ENABLED=false
NAVER_REDIRECT_URI=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 초기 관리자 시드 (auth) ─────────────────────────────────
# Vault 대상이다(값을 저장소에 쓰지 않는다). auth-service 가 기동할 때 이 이메일의 관리자(ADMIN)가 없으면 한 번 만든다 (security-guide.md §11-3).
# 이메일 · 비밀번호 둘 다 비우면 건너뛴다. 하나만 채우거나 비밀번호가 규칙(12~64자, 영문 · 숫자 포함, 공백 없는 ASCII) 밖이면 기동하지 않는다.
# 같은 이메일의 관리자가 이미 있으면 비밀번호를 덮어쓰지 않고, 고객이면 승격하지 않는다(warn). 운영은 첫 배포로 관리자를 만든 뒤 비워 둬도 된다.
# 이름은 비우면 "관리자" 다.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# ── 토스페이먼츠 (payment) ───────────────────────────────────
# 백엔드는 시크릿 키만 쓴다. 클라이언트 키는 프론트 환경변수다.
# 시크릿 키 — 결제위젯 연동이면 test_gsk_, API 개별 연동이면 test_sk_ (prod 는 live_gsk_ / live_sk_).
# local/dev 는 test_ 키로, 그 밖(prod · 프로파일 없음)은 live_ 키로만 기동한다 (payment-guide.md §2). 클라이언트 키(ck · gck)를 넣으면 기동하지 않는다.
TOSS_SECRET_KEY=
# 웹훅 검증에 시크릿을 쓰는 경우에만 채운다.
TOSS_WEBHOOK_SECRET=
# 해외 결제(PayPal) 키는 #21 에서 계약 형태를 확인한 뒤 추가한다.

# ── 오브젝트 스토리지 (product · 상품 이미지) ──────────────────
# 사용자 인프라의 S3 호환 MinIO 를 path-style 로 쓴다 (#9 D2, service-inventory.md §4). 버킷 CORS · 수명 규칙은 bootstrap-conventions.md Storage.
# STORAGE_ENABLED 는 비밀이 아니다 — Vault 에 등록하지 않고 배포 설정의 환경변수로 넣는다. 비우거나 넣지 않으면 꺼짐(false)이다.
# 켜면(true) 아래 여섯 값이 다 있어야 기동한다. endpoint · 공개 주소는 https 만(localhost · 127.0.0.1 · [::1] 만 http).
STORAGE_ENABLED=
STORAGE_ENDPOINT=
# 서명 리전. MinIO 는 서버의 리전 설정(MINIO_SITE_REGION, 없으면 us-east-1)과 같아야 한다
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# 공개 읽기 주소(CDN · 공개 버킷 도메인). 이미지 URL = 이 주소 + / + 키
# product-service 는 STORAGE_ENABLED 와 무관하게 이 값을 store.media.public-base-url 로 읽어, 어드민이 저장하는 전시 미디어 주소를 이 주소 아래로만 받는다(#63).
# 비면 미디어가 있는 전시 섹션 쓰기를 거절한다. 값이 있으면 https 만(localhost · 127.0.0.1 · [::1] 만 http) — 형식이 틀리면 기동하지 않는다
STORAGE_PUBLIC_BASE_URL=

# ── AI (Claude API, operations 예정) ─────────────────────────
# ai-core (#215, bootstrap-conventions.md AI). AI_ENABLED 는 비밀이 아니다 — Vault 에 등록하지 않고 배포 설정의 환경변수로 넣는다.
# 비우거나 넣지 않으면 꺼짐(false)이다. 켜면 AI_API_KEY 와 서비스 yml 의 타임아웃이 있어야 기동한다. ANTHROPIC_API_KEY 이름은 쓰지 않는다.
AI_ENABLED=
AI_API_KEY=
# operations AI 사용량 월 한도 (#215 PR-B). 둘 다 비밀이 아니다 — Vault 에 등록하지 않고 배포 설정의 환경변수로 넣는다.
# 월 한도 USD (예 50, 소수 6자리까지). 비면 AI 호출 예약이 실패한다 — AI 를 켤 때 함께 넣는다
AI_MONTHLY_BUDGET_USD=
# 한도 80% 경고 · 초과 알림을 받을 어드민 member id (쉼표 구분). 비면 로그 · 지표만 남긴다
AI_BUDGET_NOTIFY_MEMBER_IDS=

# ── 스토어 기능 플래그 (store.features.*) ──────────────────────
# 비밀이 아니다 — Vault 에 등록하지 않고 배포 설정의 환경변수로 넣는다 (secret-management.md §2).
# 기본값은 yml 의 false(닫힘)다. true 또는 false 를 넣고, 비우거나 넣지 않으면 false 다.
# local · dev 프로파일은 yml 이 켜 두므로 이 값을 읽지 않는다. 운영처럼 프로파일 yml 이 없는 환경만 읽는다.
# 맞춤 제작(치수 입력 · 제작 안내) — product-service
STORE_FEATURES_CUSTOM_ORDER=
# 프리오더(예약 판매) · 발송 예정 안내 — product-service
STORE_FEATURES_PREORDER=
# 상품 상세 갤러리 영상 — product-service
STORE_FEATURES_PRODUCT_VIDEO=
# 룩(Shop the Look) 고객 노출 — product-service. 어드민 룩 관리는 이 값과 무관하다
STORE_FEATURES_LOOKS=
# 해외 배송(해외 배송비 견적 · 고객 해외 정책 조회) — delivery-service
STORE_FEATURES_INTERNATIONAL_SHIPPING=

# ── 사업자 법정 표시 정보 (store.business.*) ────────────────────
# 화면에 공개되는 값이지만 고객사마다 다르고 실정보라 저장소에 쓰지 않는다.
STORE_BUSINESS_NAME=
STORE_REPRESENTATIVE_NAME=
STORE_BUSINESS_REGISTRATION_NUMBER=
STORE_MAIL_ORDER_REGISTRATION_NUMBER=
STORE_BUSINESS_ADDRESS=
STORE_CS_PHONE=
STORE_CS_EMAIL=

# ── 배포 compose (모듈별 docker-compose-<module>.yml) ─────────────
# 앱이 아니라 docker compose 가 읽는 배포 설정이다. 비밀은 아니다. 어디에 둘지(Vault · Jenkins)는 #32 · #198 에서 정한다.
# 이름 규칙 · 기동 순서 · 필수 키: backend/docs/deploy-guide.md
# JVM 시간대. 로그 시각만 바뀐다(업무 시각은 UTC Instant). 비우면 UTC
TIME_ZONE=
# 백엔드 컨테이너가 붙는 외부 docker 네트워크 이름. Infra 에서 정한다(#197). 비우면 compose 가 실패한다
COMMERCE_DOCKER_NETWORK=
# 호스트 포트. 값은 #197 에서 정한다. 컨테이너 안 포트는 application.yml 의 server.port 로 고정이다.
# 한 compose 파일에 dev · prod 가 같이 있어 파일 전체가 보간되므로 반대 환경 키도 있어야 한다 — Jenkins(#198)가 반대 환경 포트를 '0' 자리값으로 채우므로
# Vault 에는 자기 환경 포트만 넣는다(deploy-guide.md §3)
SERVICE_DISCOVERY_PORT_DEV=
SERVICE_DISCOVERY_PORT_PROD=
API_GATEWAY_PORT_DEV=
API_GATEWAY_PORT_PROD=
# 게이트웨이 호스트 포트를 묶을 주소. 비우면 루프백(127.0.0.1)이다(닫힌 기본값). 앞단(BFF · LB)이 닿아야 하는 주소만 넣는다(deploy-guide.md §6)
API_GATEWAY_BIND_DEV=
API_GATEWAY_BIND_PROD=
AUTH_SERVICE_PORT_DEV=
AUTH_SERVICE_PORT_PROD=
PRODUCT_SERVICE_PORT_DEV=
PRODUCT_SERVICE_PORT_PROD=
ORDER_SERVICE_PORT_DEV=
ORDER_SERVICE_PORT_PROD=
PAYMENT_SERVICE_PORT_DEV=
PAYMENT_SERVICE_PORT_PROD=
DELIVERY_SERVICE_PORT_DEV=
DELIVERY_SERVICE_PORT_PROD=
# 컨테이너 메모리 상한(예: 768m, 1g). JVM 힙은 이 값의 70% 다. 비우면 compose 기본값을 쓴다(deploy-guide.md §3)
SERVICE_DISCOVERY_MEM_LIMIT_DEV=
SERVICE_DISCOVERY_MEM_LIMIT_PROD=
API_GATEWAY_MEM_LIMIT_DEV=
API_GATEWAY_MEM_LIMIT_PROD=
AUTH_SERVICE_MEM_LIMIT_DEV=
AUTH_SERVICE_MEM_LIMIT_PROD=
PRODUCT_SERVICE_MEM_LIMIT_DEV=
PRODUCT_SERVICE_MEM_LIMIT_PROD=
ORDER_SERVICE_MEM_LIMIT_DEV=
ORDER_SERVICE_MEM_LIMIT_PROD=
PAYMENT_SERVICE_MEM_LIMIT_DEV=
PAYMENT_SERVICE_MEM_LIMIT_PROD=
DELIVERY_SERVICE_MEM_LIMIT_DEV=
DELIVERY_SERVICE_MEM_LIMIT_PROD=
