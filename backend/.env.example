# commerce-foundry 백엔드가 읽는 키 목록이다. 값은 비워 둔 채로 커밋한다.
#
# - 실제 값은 Vault 에 등록한다. Vault 키 이름 = 이 파일의 변수 이름이다.
# - 로컬에서는 이 파일을 backend/.env 로 복사해 테스트 값만 채운다. .env 는 .gitignore 로 막혀 있다.
# - 키를 추가·변경하면 이 파일, 쓰는 서비스의 application*.yml, Vault 를 같은 PR 에서 맞춘다.
# - 규칙 정본: backend/docs/secret-management.md / Vault 주입 방식: #32
#
# 값 뒤에 주석을 붙이지 않는다. properties 로 읽히면 주석까지 값이 된다.

# ── 실행 프로파일 ─────────────────────────────────────────
# 비워 둔다. 로컬 bootRun 은 값이 없거나 비어 있으면 local 로 뜬다(backend/build.gradle).
# 배포 환경은 반드시 명시한다 — 이 파일을 배포 템플릿으로 복사해도 local(ddl-auto update · Swagger 열림)로 뜨지 않게 하려는 것이다.
SPRING_PROFILES_ACTIVE=

# ── 서비스 디스커버리 · 게이트웨이 ─────────────────────────────
# 비밀이 아닌 로컬 기본값이라 채워 둔다.
# Eureka 클라이언트(api-gateway · 서비스 전부)가 등록할 Eureka 서버 주소. application.yml 의 기본값과 같다.
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
# api-gateway 가 CORS 를 허용할 프론트 origin. 여러 개면 콤마로 구분한다. 비우면 어떤 origin 도 허용하지 않는다.
# 공통 application.yml 의 기본값은 비어 있어(닫힘) 배포 환경은 반드시 채운다. local 프로파일 기본값은 이 값과 같다.
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── PostgreSQL (서비스 전부 · 스키마는 서비스별) ──────────────
DB_URL=jdbc:postgresql://localhost:5432/commerce_foundry
DB_USERNAME=
DB_PASSWORD=

# ── Snowflake ID (서비스 전부 · dev/prod) ─────────────────────
# 비밀은 아니지만 인스턴스마다 (datacenter, worker) 쌍이 달라야 해서 배포 환경이 넣는다. 각 0~31.
# local 은 application-local.yml 이 서비스마다 고정값을 쓰므로 비워 둔다.
SNOWFLAKE_DATACENTER_ID=
SNOWFLAKE_WORKER_ID=

# ── Redis (auth · order · api-gateway) ───────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT (auth 발급 · api-gateway·서비스 검증) ─────────────────
# 서명 방식은 #4 에서 확정한다. 비대칭 키로 가면 이 항목을 바꾼다.
JWT_SECRET_KEY=

# ── 소셜 로그인 (auth) ───────────────────────────────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 토스페이먼츠 (payment) ───────────────────────────────────
# 백엔드는 시크릿 키만 쓴다. 클라이언트 키는 프론트 환경변수다.
# local/dev 는 test_sk_ 로, prod 는 live_sk_ 로만 기동한다 (payment-guide.md §2).
TOSS_SECRET_KEY=
# 웹훅 검증에 시크릿을 쓰는 경우에만 채운다.
TOSS_WEBHOOK_SECRET=
# 해외 결제(PayPal) 키는 #21 에서 계약 형태를 확인한 뒤 추가한다.

# ── 오브젝트 스토리지 (product · 상품 이미지) ──────────────────
# 제공자는 #9 에서 결정한다 (service-inventory.md §5).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── 사업자 법정 표시 정보 (store.business.*) ────────────────────
# 화면에 공개되는 값이지만 고객사마다 다르고 실정보라 저장소에 쓰지 않는다.
STORE_BUSINESS_NAME=
STORE_REPRESENTATIVE_NAME=
STORE_BUSINESS_REGISTRATION_NUMBER=
STORE_MAIL_ORDER_REGISTRATION_NUMBER=
STORE_BUSINESS_ADDRESS=
STORE_CS_PHONE=
STORE_CS_EMAIL=
