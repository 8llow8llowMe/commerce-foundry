# commerce-foundry 백엔드가 읽는 키 목록이다. 값은 비워 둔 채로 커밋한다.
#
# - 실제 값은 Vault 에 등록한다. Vault 키 이름 = 이 파일의 변수 이름이다.
# - 로컬에서는 이 파일을 backend/.env 로 복사해 테스트 값만 채운다. .env 는 .gitignore 로 막혀 있다.
# - 키를 추가·변경하면 이 파일, 쓰는 서비스의 application*.yml, Vault 를 같은 PR 에서 맞춘다.
# - 규칙 정본: backend/docs/secret-management.md / Vault 주입 방식: #32
#
# 값 뒤에 주석을 붙이지 않는다. properties 로 읽히면 주석까지 값이 된다.

# ── 실행 프로파일 ─────────────────────────────────────────
# 비워 둔다. 로컬 bootRun 은 값이 없거나 비어 있으면 local 로 뜬다(backend/build.gradle).
# 배포 환경은 반드시 명시한다 — 이 파일을 배포 템플릿으로 복사해도 local(ddl-auto update · Swagger 열림)로 뜨지 않게 하려는 것이다.
SPRING_PROFILES_ACTIVE=

# ── 서비스 디스커버리 · 게이트웨이 ─────────────────────────────
# 비밀이 아닌 로컬 기본값이라 채워 둔다.
# Eureka 클라이언트(api-gateway · 서비스 전부)가 등록할 Eureka 서버 주소. application.yml 의 기본값과 같다.
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
# api-gateway 가 CORS 를 허용할 프론트 origin. 여러 개면 콤마로 구분한다. 비우면 어떤 origin 도 허용하지 않는다.
# 공통 application.yml 의 기본값은 비어 있어(닫힘) 배포 환경은 반드시 채운다. local 프로파일 기본값은 이 값과 같다.
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000
# api-gateway 가 X-Forwarded-For 를 믿을 프록시의 주소 · CIDR — 우리가 운영하는 BFF · L7 LB 중 XFF 를 덧붙이거나 한 값으로 덮어쓰는 것만, 공용 CDN 대역 금지. 여러 개면 콤마로 구분한다. 비우면 어떤 프록시도 믿지 않는다(소켓 원격 주소 사용).
# BFF · LB 뒤에서 비워 두면 비로그인 요청 전체가 버킷 하나다 — 그래서 비로그인 IP 계수(gateway.client-ip.enabled)는 기본 끔이다. 구성이 정해지기 전까지 비워 둔다 (backend/docs/security-guide.md §7-3).
GATEWAY_TRUSTED_PROXIES=
# api-gateway 가 비로그인 요청의 클라이언트 IP 를 Redis 키로 바꾸는 HMAC 키(비밀, Vault). base64 로 인코딩한 32바이트 이상 난수, 게이트웨이 인스턴스 전부 같은 값.
# gateway.client-ip.enabled 를 켤 때만 필수다. 끈 기본값에서는 비워도 게이트웨이가 뜬다. 만들기: openssl rand -base64 32
GATEWAY_CLIENT_IP_HASH_KEY=

# ── PostgreSQL (서비스 전부 · 스키마는 서비스별) ──────────────
DB_URL=jdbc:postgresql://localhost:5432/commerce_foundry
DB_USERNAME=
DB_PASSWORD=

# ── Snowflake ID (서비스 전부 · dev/prod) ─────────────────────
# 비밀은 아니지만 인스턴스마다 (datacenter, worker) 쌍이 달라야 해서 배포 환경이 넣는다. 각 0~31.
# local 은 application-local.yml 이 서비스마다 고정값을 쓰므로 비워 둔다.
SNOWFLAKE_DATACENTER_ID=
SNOWFLAKE_WORKER_ID=

# ── Redis (auth · order · api-gateway) ───────────────────────
# api-gateway 는 로그아웃 차단 목록을 읽는다(#4). auth 와 같은 Redis 를 가리켜야 한다 — 다르면 로그아웃한 토큰이 그대로 통과한다.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT (auth 발급 · api-gateway·서비스 검증) ─────────────────
# RS256 키 쌍이다. 값은 PEM 본문 한 줄(아머 없이)로 넣는다. 만들기·한 줄 변환·교체 순서: backend/docs/security-guide.md §6
# 서명 개인키 — PKCS#8(BEGIN PRIVATE KEY), RSA 2048비트 이상. auth-service 에만 둔다.
JWT_PRIVATE_KEY=
# 검증 공개키 — X.509(BEGIN PUBLIC KEY). auth · api-gateway · 서비스 전부가 읽는다.
JWT_PUBLIC_KEY=
# 키 교체 중에만 이전 공개키를 넣는다. 평소에는 비워 둔다.
JWT_PUBLIC_KEY_PREVIOUS=

# ── 서비스 간 인증 (서비스 5종 · api-gateway 제외) ─────────────────
# internal API 서비스 토큰의 공용 HS256 비밀이다. base64 로 인코딩한 32바이트 이상 난수를 넣고, 서비스 5종이 같은 값을 쓴다.
# 만들기: openssl rand -base64 32 / 교체 순서: backend/docs/security-guide.md §9-7
INTERNAL_JWT_SECRET=
# 비밀 교체 중에만 채운다(교체 ①은 새 비밀, ②는 옛 비밀). 평소에는 비워 둔다.
INTERNAL_JWT_SECRET_PREVIOUS=

# ── 로그인 · 회원가입 시도 제한 (auth) ─────────────────────────
# auth-service 가 로그인 · 회원가입 시도 카운터 키(정규화 이메일)를 Redis 키로 바꾸는 HMAC 키(비밀, Vault). base64 로 인코딩한 32바이트 이상 난수, auth 인스턴스 전부 같은 값.
# 시도 제한(auth.login-guard.enabled)이 기본 켬이라 필수다 — 비면 auth 가 뜨지 않는다. 바꾸면 진행 중인 시도 창이 초기화된다 (security-guide.md §12-4).
# 만들기: openssl rand -base64 32
AUTH_LOGIN_GUARD_HASH_KEY=

# ── 소셜 로그인 (auth) ───────────────────────────────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 초기 관리자 시드 (auth) ─────────────────────────────────
# Vault 대상이다(값을 저장소에 쓰지 않는다). auth-service 가 기동할 때 이 이메일의 관리자(ADMIN)가 없으면 한 번 만든다 (security-guide.md §11-3).
# 이메일 · 비밀번호 둘 다 비우면 건너뛴다. 하나만 채우거나 비밀번호가 규칙(12~64자, 영문 · 숫자 포함, 공백 없는 ASCII) 밖이면 기동하지 않는다.
# 같은 이메일의 관리자가 이미 있으면 비밀번호를 덮어쓰지 않고, 고객이면 승격하지 않는다(warn). 운영은 첫 배포로 관리자를 만든 뒤 비워 둬도 된다.
# 이름은 비우면 "관리자" 다.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# ── 토스페이먼츠 (payment) ───────────────────────────────────
# 백엔드는 시크릿 키만 쓴다. 클라이언트 키는 프론트 환경변수다.
# local/dev 는 test_sk_ 로, prod 는 live_sk_ 로만 기동한다 (payment-guide.md §2).
TOSS_SECRET_KEY=
# 웹훅 검증에 시크릿을 쓰는 경우에만 채운다.
TOSS_WEBHOOK_SECRET=
# 해외 결제(PayPal) 키는 #21 에서 계약 형태를 확인한 뒤 추가한다.

# ── 오브젝트 스토리지 (product · 상품 이미지) ──────────────────
# 사용자 인프라의 S3 호환 MinIO 를 path-style 로 쓴다 (#9 D2, service-inventory.md §4). 버킷 CORS · 수명 규칙은 bootstrap-conventions.md Storage.
# STORAGE_ENABLED 는 비밀이 아니다 — Vault 에 등록하지 않고 배포 설정의 환경변수로 넣는다. 비우거나 넣지 않으면 꺼짐(false)이다.
# 켜면(true) 아래 여섯 값이 다 있어야 기동한다. endpoint · 공개 주소는 https 만(localhost · 127.0.0.1 · [::1] 만 http).
STORAGE_ENABLED=
STORAGE_ENDPOINT=
# 서명 리전. MinIO 는 서버의 리전 설정(MINIO_SITE_REGION, 없으면 us-east-1)과 같아야 한다
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# 공개 읽기 주소(CDN · 공개 버킷 도메인). 이미지 URL = 이 주소 + / + 키
STORAGE_PUBLIC_BASE_URL=

# ── 스토어 기능 플래그 (store.features.*) ──────────────────────
# 비밀이 아니다 — Vault 에 등록하지 않고 배포 설정의 환경변수로 넣는다 (secret-management.md §2).
# 기본값은 yml 의 false(닫힘)다. true 또는 false 를 넣고, 비우거나 넣지 않으면 false 다.
# local · dev 프로파일은 yml 이 켜 두므로 이 값을 읽지 않는다. 운영처럼 프로파일 yml 이 없는 환경만 읽는다.
# 맞춤 제작(치수 입력 · 제작 안내) — product-service
STORE_FEATURES_CUSTOM_ORDER=
# 해외 배송(해외 배송비 견적 · 고객 해외 정책 조회) — delivery-service
STORE_FEATURES_INTERNATIONAL_SHIPPING=

# ── 사업자 법정 표시 정보 (store.business.*) ────────────────────
# 화면에 공개되는 값이지만 고객사마다 다르고 실정보라 저장소에 쓰지 않는다.
STORE_BUSINESS_NAME=
STORE_REPRESENTATIVE_NAME=
STORE_BUSINESS_REGISTRATION_NUMBER=
STORE_MAIL_ORDER_REGISTRATION_NUMBER=
STORE_BUSINESS_ADDRESS=
STORE_CS_PHONE=
STORE_CS_EMAIL=
